# Razorpay / OpenAI / mandate keys

# Razorpay Dashboard → Test Mode → API Keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxx

# Optional. Shop works without this (rule-based buyer agent).
OPENAI_API_KEY=

# Optional. If set, POST /api/mcp requires Authorization: Bearer <secret>
MCP_SHARED_SECRET=

# Absolute site origin for MCP payment_link_url (/pay/{orderId}). Local default: http://localhost:3000
PUBLIC_APP_URL=http://localhost:3000
# Optional: public origin for email images (Gmail cannot load localhost). e.g. your Azure app URL
# EMAIL_ASSET_ORIGIN=https://your-app.azurewebsites.net

# Optional cart-reminder email (Resend). Never required for MCP / shopping.
RESEND_API_KEY=
# e.g. Circuit <noreply@yourdomain.com> after Resend domain verify
RESEND_FROM=
# Bearer secret for POST /api/cron/abandoned-cart
CRON_SECRET=
# 0 = eligible on next cron tick (demo). Prod can use 86400000 (24h) if desired.
ABANDONED_CART_MIN_AGE_MS=0

# Buyer mandate authority (Ed25519). Signer holds private; merchant verifies with public.
# Demo keys are embedded for local runs. Rotate for recording:
#   node scripts/gen-mandate-keys.mjs
BUYER_MANDATE_PRIVATE_KEY_B64=
BUYER_MANDATE_PUBLIC_KEY_B64=

# Legacy HMAC name kept unused — prefer Ed25519 pair above.
# MANDATE_SECRET=

# Azure App Service: persistent shopper/cart/audit store
# DATA_DIR=/home/data
